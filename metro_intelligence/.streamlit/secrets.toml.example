# Copy to secrets.toml on the private server. Never commit real values.
[auth]
redirect_uri = "https://YOUR-PRIVATE-HOST/oauth2callback"
cookie_secret = "REPLACE-WITH-A-SECURE-RANDOM-SECRET"
client_id = "YOUR-OIDC-CLIENT-ID"
client_secret = "YOUR-OIDC-CLIENT-SECRET"
server_metadata_url = "https://YOUR-IDENTITY-PROVIDER/.well-known/openid-configuration"

[roles]
"approved.person@company.example" = "analyst"
"approved.executive@company.example" = "executive"

# Optional: approved OpenAI-compatible chat-completions service.
# Questions are sent only when the user opts in; workbook rows are never sent.
# [ai]
# endpoint = "https://YOUR-APPROVED-PROVIDER/v1/chat/completions"
# model = "YOUR-APPROVED-MODEL"
# api_key = "SET-SECURELY-ON-SERVER"
